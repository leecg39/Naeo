{
  "manifest_version": 3,
  "name": "NAEO 네이버 블로그 발행 도우미",
  "description": "NAEO에 저장한 글을 조각별로 복사하고 네이버 블로그 편집 위치를 찾아줍니다.",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "identity",
    "sidePanel",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://blog.naver.com/*",
    "https://m.blog.naver.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "NAEO 발행 도우미 열기"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
