{
  "name": "naeo-local-clone",
  "version": "1.0.0",
  "private": true,
  "engines": { "node": "^22.16.0 || >=24.0.0" },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs && node --import tsx --test tests/server/*.test.ts",
    "test:server": "node --import tsx --test tests/server/*.test.ts",
    "admin": "node --import tsx scripts/admin.ts",
    "worker": "node --import tsx scripts/worker.ts",
    "lint": "eslint src/server src/components/account src/components/admin src/components/contact src/components/content src/components/events src/components/creative src/lib/api-client.ts src/lib/inquiry-labels.ts src/lib/safe-next.ts src/app/api src/app/robots.ts src/app/sitemap.ts src/app/rss.xml src/app/llms.txt src/app/login src/app/auth src/app/admin src/app/dashboard/settings src/app/dashboard/social tests/server scripts/admin.ts scripts/worker.ts scripts/route-audit.ts scripts/content",
    "content:extract": "node --import tsx scripts/content/extract-articles.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "github-slugger": "2.0.0",
    "lucide-react": "^0.577.0",
    "mdast-util-directive": "3.1.0",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-directive": "4.0.0",
    "micromark-extension-gfm": "3.0.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdast": "4.0.4",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "cheerio": "^1.2.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
