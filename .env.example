# ── 필수 ───────────────────────────────────────────────
# 서비스 주소(origin). 쿠키 Secure·OAuth 리디렉션·MCP 주소·Origin 검사에 쓰인다.
NAEO_APP_URL=http://127.0.0.1:3000
# SQLite 파일(지속 볼륨에 두고 웹 루트 밖). 운영·개발·QA는 서로 다른 파일을 쓴다.
NAEO_DATABASE_PATH=var/naeo.sqlite
# 사진·내보내기 파일 폴더(웹 루트 밖).
NAEO_UPLOAD_DIR=var/uploads

# ── 배포 환경 ──────────────────────────────────────────
# X-Forwarded-For를 덮어쓰는 프록시 뒤에서만 1.
NAEO_TRUST_PROXY=0
# 실제 운영 도메인에서만 1(검색 노출 허용). 기본은 차단.
NAEO_ALLOW_INDEXING=0
# 작업자 대기 간격(ms).
NAEO_WORKER_IDLE_MS=2000

# ── 외부 연동(비우면 '미설정'으로 표시되고 결과를 만들어내지 않음) ──
# AI 글 생성(Anthropic). NAEO_AI_BASE_URL은 https(로컬 검증만 http://localhost).
ANTHROPIC_API_KEY=
NAEO_AI_MODEL=claude-sonnet-4-6
NAEO_AI_BASE_URL=
# 결제(토스페이먼츠). 웹훅 URL: {NAEO_APP_URL}/api/billing/webhooks/toss
NAEO_TOSS_CLIENT_KEY=
NAEO_TOSS_SECRET_KEY=
# 로그인(리디렉션 URI: {NAEO_APP_URL}/api/auth/oauth/google/callback, …/naver/callback)
NAEO_GOOGLE_CLIENT_ID=
NAEO_GOOGLE_CLIENT_SECRET=
NAEO_NAVER_CLIENT_ID=
NAEO_NAVER_CLIENT_SECRET=
# 크롬 확장 프로그램 ID(쉼표 구분). /auth/extension 연결 허용 목록.
NAEO_EXTENSION_IDS=

# ── 개발·검증 전용(운영에서는 설정하지 않음, localhost만 허용) ──
# NAEO_TOSS_API_BASE=http://127.0.0.1:3199
# NAEO_OAUTH_ENDPOINT_BASE=http://127.0.0.1:3198
