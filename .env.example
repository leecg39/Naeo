# ── 필수 ───────────────────────────────────────────────
# 서비스 주소(origin). 쿠키 Secure·OAuth 리디렉션·MCP 주소·Origin 검사에 쓰인다.
NAEO_APP_URL=http://127.0.0.1:3000
# SQLite 파일(지속 볼륨에 두고 웹 루트 밖). 운영·개발·QA는 서로 다른 파일을 쓴다.
NAEO_DATABASE_PATH=var/naeo.sqlite
# 사진·내보내기 파일 폴더(웹 루트 밖).
NAEO_UPLOAD_DIR=var/uploads

# ── 배포 환경 ──────────────────────────────────────────
# X-Forwarded-For를 덮어쓰는 프록시 뒤에서만 1.
NAEO_TRUST_PROXY=0
# 실제 운영 도메인에서만 1(검색 노출 허용). 기본은 차단.
NAEO_ALLOW_INDEXING=0
# 작업자 대기 간격(ms).
NAEO_WORKER_IDLE_MS=2000

# ── 외부 연동(비우면 '미설정'으로 표시되고 결과를 만들어내지 않음) ──
# AI 글 생성(Anthropic). NAEO_AI_BASE_URL은 https(로컬 검증만 http://localhost).
ANTHROPIC_API_KEY=
NAEO_AI_MODEL=claude-sonnet-4-6
NAEO_AI_BASE_URL=
# 결제(토스페이먼츠). 웹훅 URL: {NAEO_APP_URL}/api/billing/webhooks/toss
NAEO_TOSS_CLIENT_KEY=
NAEO_TOSS_SECRET_KEY=
# 로그인(리디렉션 URI: {NAEO_APP_URL}/api/auth/oauth/google/callback, …/naver/callback)
NAEO_GOOGLE_CLIENT_ID=
NAEO_GOOGLE_CLIENT_SECRET=
NAEO_NAVER_CLIENT_ID=
NAEO_NAVER_CLIENT_SECRET=
# 회원별 ChatGPT 연결(Sign in with ChatGPT 승인 클라이언트).
# 콜백: {NAEO_APP_URL}/api/account/openai/callback
NAEO_OPENAI_CLIENT_ID=
# 공개 클라이언트는 비워 두고 NAEO_OPENAI_TOKEN_AUTH_METHOD=none. 비밀 클라이언트만 secret을 설정한다.
NAEO_OPENAI_CLIENT_SECRET=
NAEO_OPENAI_TOKEN_AUTH_METHOD=none
# 32바이트 무작위 키의 64자리 hex. 토큰 암호화용이며 저장소·로그에 남기지 않는다.
NAEO_OPENAI_TOKEN_ENCRYPTION_KEY=
# 크롬 확장 프로그램 ID(쉼표 구분). /auth/extension 연결 허용 목록.
NAEO_EXTENSION_IDS=
# AI 브리핑 인용 확인(SerpApi Naver·Naver AI Overview 엔진). 둘 다 있어야 활성화.
# 키워드 하나당 검색 1~2회, 확인 1회는 최근 글 10개, 회원당 하루 2회(진단 후 자동 확인 포함).
NAEO_CITATION_PROVIDER=
NAEO_SERPAPI_KEY=
# desktop(기본) 또는 mobile 화면 기준.
NAEO_CITATION_DEVICE=desktop
# AI 이미지 생성(OpenAI Images API — 회원 ChatGPT OAuth와 별개의 API 키). 둘 다 있어야 활성화.
# 이미지 1장당 1토큰, 만들어지지 못한 장은 자동 환급.
NAEO_IMAGE_PROVIDER=
NAEO_IMAGE_API_KEY=
# NAEO_IMAGE_MODEL=gpt-image-1
# NAEO_IMAGE_SIZE=1024x1024

# ── 개발·검증 전용(운영에서는 설정하지 않음, localhost만 허용) ──
# NAEO_TOSS_API_BASE=http://127.0.0.1:3199
# NAEO_OAUTH_ENDPOINT_BASE=http://127.0.0.1:3198
# OpenAI OAuth 로컬 검증 전용: NAEO_OPENAI_OAUTH_BASE=http://127.0.0.1:LOCAL_TEST_PORT
# OpenAI API 로컬 검증 전용: NAEO_OPENAI_API_BASE=http://127.0.0.1:LOCAL_TEST_PORT/v1
# AI 인용 확인 로컬 검증 전용: NAEO_SERPAPI_BASE=http://127.0.0.1:LOCAL_TEST_PORT
# AI 이미지 로컬 검증 전용: NAEO_IMAGE_API_BASE=http://127.0.0.1:LOCAL_TEST_PORT

# ── 계정 안내 메일(재설정·이메일 인증, Resend) ──
# 네 값을 모두 설정해야 활성화. 발신 도메인은 Resend에서 검증해야 한다.
NAEO_EMAIL_PROVIDER=
NAEO_RESEND_API_KEY=
NAEO_MAIL_FROM=
# 32바이트 무작위 키의 64자리 hex. 웹 서버·worker에 같은 값을 배포하고 별도로 안전하게 보관한다.
# 발급 예: openssl rand -hex 32 (발급한 값은 저장소·로그에 남기지 않는다)
NAEO_MAIL_ENCRYPTION_KEY=
# 로컬 검증 전용: NAEO_MAIL_API_BASE=http://127.0.0.1:3197

# Optional Twilio Verify (explicit configuration; no automatic SMS)
NAEO_SMS_PROVIDER=
NAEO_TWILIO_ACCOUNT_SID=
NAEO_TWILIO_VERIFY_SERVICE_SID=
NAEO_TWILIO_API_KEY=
NAEO_TWILIO_API_SECRET=
# NAEO_SMS_API_BASE=http://127.0.0.1:LOCAL_TEST_PORT

# Stable separate 32-byte key for one-time phone rewards: openssl rand -hex 32
# Back up separately. Changing after the first award disables further awards.
NAEO_PHONE_REWARD_KEY=
